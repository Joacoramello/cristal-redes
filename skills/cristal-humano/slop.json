 "structures": [
  {
   "id": "no-solo",
   "regex": "(?i)\\bno (?:es )?(?:solo|sólo|solamente) [^.!?\\n]{2,60}[,;.]\\s*(?:es|sino)\\b",
   "name": "\"No es solo X, es Y\"",
   "fix": "Decí la única cosa que querés decir. Borrá la mitad que prepara."
  },
  {
   "id": "no-solo-sino",
   "regex": "(?i)\\bno solo\\b[^.!?\\n]{2,80}\\bsino (?:también|que)\\b",
   "name": "\"No solo X sino también Y\"",
   "fix": "Partilo en dos oraciones o sacá la mitad más floja."
  },
  {
   "id": "no-se-trata",
   "regex": "(?i)\\bno se trata de [^.!?\\n]{2,60}[.,;]\\s*se trata de\\b",
   "name": "\"No se trata de X. Se trata de Y.\"",
   "fix": "Arrancá por Y. La vuelta es lo que delata."
  },
  {
   "id": "pregunta-escenario",
   "regex": "(?im)^\\s*¿(?:el resultado|lo mejor|la clave|el secreto|la diferencia|la respuesta|lo peor|el truco)\\?\\s*$",
   "name": "Pregunta retórica de una línea (¿El resultado?)",
   "fix": "Respondé en la misma oración en vez de armar un suspenso."
  },
  {
   "id": "esto-aprendi",
   "regex": "(?i)\\besto es lo que aprend(?:í|imos)\\b",
   "name": "\"Esto es lo que aprendí\"",
   "fix": "Decí lo aprendido. Saltate el anuncio."
  },
  {
   "id": "triada",
   "regex": "(?i)\\b\\w+, \\w+ y \\w+\\.",
   "name": "Tríada (X, Y y Z.)",
   "fix": "Dos cosas o cuatro. Tres es el ritmo por defecto de la IA."
  },
  {
   "id": "emoji-cohete",
   "regex": "[🚀🔥💡✨🎯💯🙌]",
   "name": "Emoji cohete / fuego / lamparita / brillitos / diana / 100",
   "fix": "Un emoji como máximo, y que no sea de estos."
  },
  {
   "id": "muro-hashtags",
   "regex": "(?:#\\w+[ \\t]*){6,}",
   "name": "Muro de hashtags (6 o más)",
   "fix": "Instagram toma hasta 5 desde dic-2025. Elegí 3 a 5 temáticos."
  },
  {
   "id": "como-ia",
   "regex": "(?i)\\bcomo (?:una )?(?:ia|inteligencia artificial|modelo de lenguaje)\\b",
   "name": "La IA hablando de sí misma",
   "fix": "Borrá la oración entera."
  },
  {
   "id": "en-resumen",
   "regex": "(?im)^\\s*(?:en resumen|en conclusión|para concluir|en síntesis)\\b",
   "name": "Cierre de redacción escolar",
   "fix": "Un post no lleva párrafo de conclusión."
  },
  {
   "id": "cebo-final",
   "regex": "(?i)¿(?:qué opinan|vos qué (?:pensás|opinás)|ustedes qué (?:piensan|opinan)|están de acuerdo|me equivoco|qué piensan)\\?\\s*$",
   "name": "Pregunta cebo al final",
   "fix": "Preguntá algo que solo vos podés preguntar, sobre lo puntual de arriba."
  },
  {
   "id": "para-scroll",
   "regex": "(?im)^\\s*[¡¿]?\\s*(?:par[aá] de scrollear|no scrollees|esper[aá],? no pases|no pases)\\b",
   "name": "Arranque \"pará de scrollear\"",
   "fix": "El freno tiene que ser la afirmación misma. Pedir atención delata que no te la ganaste."
  },
  {
   "id": "preambulo",
   "regex": "(?i)\\b(?:en (?:este|el) (?:video|reel|post)(?: de hoy)?|hoy (?:les|te) (?:traigo|voy a mostrar|voy a enseñar)|(?:les|te) voy a (?:mostrar|enseñar))\\b",
   "name": "Preámbulo (\"en este video les voy a mostrar\")",
   "fix": "Borralo y arrancá por el resultado. Los dos primeros segundos deciden todo."
  },
  {
   "id": "emoji-vinetas",
   "regex": "(?m)^\\s*[🌀-🫿✅➡⬅✔✨👉]\\s*\\S",
   "name": "Lista con emojis de viñeta",
   "fix": "Guion o salto de línea. Las viñetas con emoji son lo más de plantilla que hay en un caption."
  },
  {
   "id": "mayusculas",
   "regex": "\\b[A-ZÁÉÍÓÚÑ]{3,}\\b(?:\\s+\\b[A-ZÁÉÍÓÚÑ]{3,}\\b){2,}",
   "name": "Tres o más palabras gritadas seguidas",
   "fix": "Las mayúsculas son volumen, no resaltador. Una palabra como mucho."
  },
  {
   "id": "cebo-seguir",
   "regex": "(?i)\\b(?:seguinos para más|no te olvides de seguirnos|etiquetá a (?:alguien|un amigo|una amiga|tu)|dale (?:like|me gusta) si|compartí si|comentá si)\\b",
   "name": "Cebo de seguir o etiquetar",
   "fix": "Pedí la única acción que este post se ganó. El pedido genérico entrena a ignorar todos."
  },
  {
   "id": "precio-privado",
   "regex": "(?i)\\bprecio(?:s)? (?:por|al|en) (?:privado|dm|md|inbox|interno)\\b|\\bconsult(?:á|a|ar) (?:el )?precio por (?:privado|dm|md|interno)\\b",
   "name": "\"Precio por privado\"",
   "fix": "En Argentina espanta. Poné el precio de Odoo, o explicá en una línea por qué varía y mandá a WhatsApp."
  },
  {
   "id": "gritos",
   "regex": "!{2,}|¡[^!\\n]{1,60}!(?:\\s*¡[^!\\n]{1,60}!){2,}",
   "name": "Exclamación en cada frase",
   "fix": "Una exclamación por posteo alcanza. El resto, punto."
  },
  {
   "id": "tuteo-ambiguo",
   "regex": "(?m)(?:^|[.!?]\\s+)(?:Limpia|Elimina|Quita|Deja|Lava|Protege|Mezcla|Lleva|Cuida|Renueva|Transforma)\\s+(?:tu|tus)\\b",
   "name": "Imperativo en tuteo (\"Lleva tu...\")",
   "fix": "Pasalo a voseo: Llevá, Limpiá, Dejá, Cuidá..."
  },
  {
   "id": "perfecto-tu",
   "regex": "(?i)\\b(?:has|hayas) (?:\\w+(?:ado|ido|ito|uesto|echo))\\b",
   "name": "Pretérito en tuteo (\"has visto\")",
   "fix": "En rioplatense va el pasado simple: \"viste\", \"probaste\"."
